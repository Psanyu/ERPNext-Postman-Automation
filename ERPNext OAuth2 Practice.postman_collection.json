        "exec": [
          "const apiHelpersCode = `\r",
          "\r",
          "function verifyStatus(expectedStatus) {\r",
          "    pm.test(\\`Status code is \\${expectedStatus}\\`, function () {\r",
          "        pm.response.to.have.status(expectedStatus);\r",
          "    });\r",
          "}\r",
          "\r",
          "function verifyJsonResponse() {\r",
          "    pm.test(\"Response is JSON\", function () {\r",
          "        pm.response.to.be.json;\r",
          "    });\r",
          "}\r",
          "\r",
          "function getJsonData() {\r",
          "    return pm.response.json();\r",
          "}\r",
          "\r",
          "function verifyExceptionType(expectedType) {\r",
          "    const jsonData = getJsonData();\r",
          "\r",
          "    pm.test(\\`Exception type is \\${expectedType}\\`, function () {\r",
          "        pm.expect(jsonData).to.have.property(\"exc_type\");\r",
          "        pm.expect(jsonData.exc_type).to.eql(expectedType);\r",
          "    });\r",
          "}\r",
          "\r",
          "function verifyDataNotNull() {\r",
          "    const jsonData = getJsonData();\r",
          "\r",
          "    pm.test(\"Customer data is not null\", function () {\r",
          "        pm.expect(jsonData).to.have.property(\"data\");\r",
          "        pm.expect(jsonData.data).to.not.be.null;\r",
          "    });\r",
          "}\r",
          "\r",
          "function verifyDataArray() {\r",
          "    const jsonData = getJsonData();\r",
          "\r",
          "    pm.test(\"Response contains customer data\", function () {\r",
          "        pm.expect(jsonData).to.have.property(\"data\");\r",
          "        pm.expect(jsonData.data).to.be.an(\"array\");\r",
          "        pm.expect(jsonData.data.length).to.be.above(0);\r",
          "    });\r",
          "}\r",
          "`;\r",
          "\r",
          "pm.variables.set(\"apiHelpersCode\", apiHelpersCode);"
        ]
      }
