    {
      "name": "03 - POST New Auth",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "eval(pm.variables.get(\"apiHelpersCode\"));\r\n\r\npm.collectionVariables.unset(\"createdCustomerName\");\r\n\r\nverifyStatus(200);\r\nverifyJsonResponse();\r\n\r\nconst jsonData = getJsonData();\r\n\r\nconst expected = {\r\n    customer_name:  pm.variables.get(\"customerName\"),\r\n    customer_type:  pm.variables.get(\"customerType\"),\r\n    customer_group: pm.variables.get(\"customerGroup\"),\r\n    territory:      pm.variables.get(\"territory\")\r\n};\r\n\r\npm.test(\"Iteration data is present (data file attached)\", function () {\r\n    Object.keys(expected).forEach(function (key) {\r\n        pm.expect(expected[key], key + \" missing from data file\").to.not.be.undefined;\r\n    });\r\n});\r\n\r\npm.test(\"Response contains customer data object\", function () {\r\n    pm.expect(jsonData, \"response body\").to.be.an(\"object\");\r\n    pm.expect(jsonData.data, \"jsonData.data\").to.be.an(\"object\");\r\n});\r\n\r\nif (pm.response.code === 200 && jsonData && jsonData.data) {\r\n\r\n    pm.test(\"Created customer has a name\", function () {\r\n        pm.expect(jsonData.data.name).to.be.a(\"string\").and.not.empty;\r\n    });\r\n\r\n    // Only store the name once we know the response is good\r\n    pm.collectionVariables.set(\"createdCustomerName\", jsonData.data.name);\r\n\r\n    Object.keys(expected).forEach(function (key) {\r\n        pm.test(key + \" is correct\", function () {\r\n            pm.expect(jsonData.data[key]).to.eql(expected[key]);\r\n        });\r\n    });\r\n}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const names = [\"OAuth DD Customer 01\", \"OAuth DD Customer 02\", \"OAuth DD Customer 03\"];\r\nconst i = pm.info.iteration % names.length;\r\npm.collectionVariables.set(\"customerName\", names[i]);"
            ]
          }
        }
