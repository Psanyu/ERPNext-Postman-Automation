  "item": [
    {
      "name": "01 - Get Authorization Code",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "eval(pm.variables.get(\"apiHelpersCode\"));\r\n\r\nverifyStatus(200);\r\n\r\npm.test(\"Authorization page is returned\", function () {\r\n    const body = pm.response.text();\r\n    // Postman (logged in) gets the consent screen; Newman (no session) gets the login page.\r\n    const isConsent = body.includes(\"Confirm Access\");\r\n    const isLogin = /login/i.test(body);\r\n    pm.expect(isConsent || isLogin, \"neither consent nor login page found\").to.be.true;\r\n});\r\n"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"state\", pm.variables.replaceIn(\"{{$randomUUID}}\"));\r\n"
